// PerFin core shell (task 2c). GENERATED by perfin_excel_core.powerquery from
// contracts/schemas/report_tables.json; edit the generator, not this file.
// Read-only, local-only: refresh never writes back to any source.
// rpt_accounts: read-only refresh of <data root>\reports\rpt_accounts.csv (contract 1.0.0).
let
    Source = fnPerFinReadCsv("rpt_accounts.csv", {
        {"account_id", "id", false},
        {"display_name", "text", false},
        {"kind", "enum", false},
        {"account_class", "enum", false},
        {"currency", "currency", false},
        {"ledger_balance_minor", "money_minor", false},
        {"display_balance_minor", "money_minor", false},
        {"balance_as_of", "date", false},
        {"include_in_net_worth", "boolean", false},
        {"liquidity", "enum", true},
        {"ownership_pct", "integer", true},
        {"legal_liability_pct", "integer", true},
        {"tax_status", "enum", true}
    }),
    Bad = Table.SelectRows(Source, each ([kind] <> "asset" and [kind] <> "liability")
        or [display_balance_minor] <> (if [kind] = "liability" then -[ledger_balance_minor] else [ledger_balance_minor])),
    Result = if Table.RowCount(Bad) > 0 then error Error.Record("PerFin.Invalid",
        "rpt_accounts.csv: display_balance_minor must equal the ledger balance (assets) or minus it (liabilities)")
        else Source
in
    Result
