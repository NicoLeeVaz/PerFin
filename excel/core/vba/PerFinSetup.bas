Attribute VB_Name = "PerFinSetup"
' PerFin core shell (task 2c): one-time installation of the Power Query definitions
' into a workbook generated by `python -m perfin_excel_core build` (openpyxl cannot
' create queries or embed VBA). Reads excel\core\powerquery\queries.txt and the .pq
' files next to it, adds each query, and turns each generated placeholder table into a
' query table of the same name at the same place. Formulas are saved first and put
' back afterwards, because deleting a placeholder table breaks structured references.
' Local files only. Behaviour of the Queries/ListObjects APIs is [Unverified] until
' the Windows checklist (docs/excel/windows-checklist.md) has been run.
Option Explicit

Public Sub PerFin_InstallQueries()
    Dim folder As String, manifest As String, lines() As String, i As Long, parts() As String
    Dim saved As Collection, item As Variant, ws As Worksheet, count As Long

    folder = Trim$(InputBox("Folder that holds queries.txt and the PerFin .pq files " & _
                            "(excel\core\powerquery):", "PerFin setup"))
    If Len(folder) = 0 Then Exit Sub
    If Right$(folder, 1) = "\" Then folder = Left$(folder, Len(folder) - 1)
    If Not PerFin_IsLocalPath(folder) Or Len(Dir$(folder & "\queries.txt")) = 0 Then
        MsgBox "queries.txt not found in a local folder: " & folder, vbExclamation, "PerFin setup"
        Exit Sub
    End If
    If Len(PerFin_Setting("PerFin_DataRoot")) = 0 Then
        MsgBox "Set the data root on the Settings sheet first (the first refresh must succeed " & _
               "to create the table columns).", vbExclamation, "PerFin setup"
        Exit Sub
    End If

    Set saved = SaveFormulas()
    PerFin_UnprotectAll
    On Error GoTo Failed
    manifest = PerFin_ReadTextFile(folder & "\queries.txt")
    lines = Split(manifest, vbCrLf)
    For i = LBound(lines) To UBound(lines)
        If Len(lines(i)) > 0 And Left$(lines(i), 1) <> "#" Then
            parts = Split(lines(i), "|")
            UpsertQuery parts(0), PerFin_ReadTextFile(folder & "\" & parts(0) & ".pq")
            count = count + 1
        End If
    Next i
    SetDataRootParameter
    For i = LBound(lines) To UBound(lines)
        If Len(lines(i)) > 0 And Left$(lines(i), 1) <> "#" Then
            parts = Split(lines(i), "|")
            If parts(1) = "table" Then LoadToTable parts(0)
        End If
    Next i
    RestoreFormulas saved
    PerFin_ProtectAll
    MsgBox "Installed " & count & " queries. Save as PerFin-Core.xlsm in <data root>\workbooks, " & _
           "then use PerFin_Refresh.", vbInformation, "PerFin setup"
    Exit Sub
Failed:
    MsgBox "PerFin setup stopped: " & Err.Description & vbLf & _
           "Close without saving and start again from the generated template.", vbCritical, "PerFin setup"
End Sub

Private Sub SetDataRootParameter()
    ThisWorkbook.Queries("PerFinDataRoot").Formula = """" & Replace(PerFin_DataRoot(), """", """""") & _
        """ meta [IsParameterQuery = true, Type = ""Text"", IsParameterQueryRequired = false]"
End Sub

Private Sub UpsertQuery(ByVal name As String, ByVal formula As String)
    Dim q As WorkbookQuery
    On Error Resume Next
    Set q = ThisWorkbook.Queries(name)
    On Error GoTo 0
    If q Is Nothing Then
        ThisWorkbook.Queries.Add name, formula
    Else
        q.Formula = formula
    End If
End Sub

Private Sub LoadToTable(ByVal name As String)
    Dim lo As ListObject, ws As Worksheet, dest As Range
    Set lo = PerFin_FindTable(name)
    If lo Is Nothing Then Err.Raise vbObjectError + 520, "PerFin setup", "placeholder table missing: " & name
    If lo.SourceType = xlSrcQuery Then Exit Sub   ' already a query table
    Set ws = lo.Parent
    Set dest = lo.Range.Cells(1, 1)
    lo.Delete
    Set lo = ws.ListObjects.Add(SourceType:=xlSrcExternal, _
        Source:="OLEDB;Provider=Microsoft.Mashup.OleDb.1;Data Source=$Workbook$;Location=" & name & _
                ";Extended Properties=""""", Destination:=dest)
    With lo.QueryTable
        .CommandType = xlCmdSql
        .CommandText = Array("SELECT * FROM [" & name & "]")
        .RowNumbers = False
        .FillAdjacentFormulas = False
        .PreserveFormatting = True
        .RefreshOnFileOpen = False
        .BackgroundQuery = False
        .RefreshStyle = xlInsertDeleteCells
        .SaveData = True
        .AdjustColumnWidth = False
        .Refresh BackgroundQuery:=False
    End With
    lo.Name = name
End Sub

Private Function SaveFormulas() As Collection
    Dim c As Collection, ws As Worksheet, cell As Range
    Set c = New Collection
    For Each ws In ThisWorkbook.Worksheets
        For Each cell In ws.UsedRange
            If cell.HasFormula Then c.Add Array(ws.Name, cell.Address, cell.Formula)
        Next cell
    Next ws
    Set SaveFormulas = c
End Function

Private Sub RestoreFormulas(ByVal saved As Collection)
    Dim item As Variant
    For Each item In saved
        ThisWorkbook.Worksheets(item(0)).Range(item(1)).Formula = item(2)
    Next item
End Sub
