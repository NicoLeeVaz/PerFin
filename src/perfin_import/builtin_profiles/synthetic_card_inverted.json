    "skip_footer_rows": 0,
    "expected_field_count": 5
  },
  "columns": {
    "transaction_date": "Trans Date",
    "posted_date": "Post Date",
    "description": "Description",
    "amount": "Amount",
    "source_txn_id": "Reference"
  },
  "date_format": "MM/DD/YYYY",
  "amount": {
    "sign_rule": "invert",
    "decimal_separator": ".",
    "thousands_separator": ",",
    "currency": "USD",
    "parentheses_negative": false
  },
  "dedupe_key": [
    "source_txn_id",
    "posted_date",
    "amount_minor",
    "description",
    "row_occurrence"
  ]
