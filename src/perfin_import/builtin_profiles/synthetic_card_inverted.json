{
  "contract": "perfin",
  "contract_version": "1.0.0",
  "document_type": "import_profile",
  "profile_id": "synthetic_card_inverted",
  "profile_version": "1.0.0",
  "description": "Credit-card export (UTF-8 with BOM) where charges are positive and payments/refunds negative; the sign is inverted to the canonical ledger sign. SYNTHETIC profile for tests and examples; not verified against any real institution's export.",
