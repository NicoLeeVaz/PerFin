{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perfin/1.0/common.schema.json",
  "title": "PerFin shared definitions (contract 1.0.0)",
  "$comment": "Uses only the keyword subset implemented by perfin_contracts.schema_subset. 'number' is intentionally never used: money is integer minor units, rates are decimal strings.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,15}:[a-z0-9][a-z0-9_.-]{0,47}$",
      "description": "Stable '<class prefix>:<alias>' id, e.g. chk:main, card:visa_a. Never a card or account number."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time-utc",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "money_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Signed integer minor units (USD cents). Bounded to +/-(2^53-1) so Excel/VBA doubles hold it exactly."
    },
    "money_minor_nonneg": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "apr": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$",
      "description": "APR as a decimal fraction string, 24.99% = \"0.2499\". Never a binary float."
    },
    "pct_int": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free text stored and displayed as text. Excel writers must write it as a string cell (never a formula), even when it begins with = + - @."
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    },
    "review_state": {
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "error_code": {
      "enum": [
        "E_SCHEMA",
        "E_TYPE",
        "E_REQUIRED",
        "E_UNKNOWN_FIELD",
        "E_ENUM",
        "E_PATTERN",
        "E_RANGE",
        "E_LENGTH",
        "E_DATE_INVALID",
        "E_AMOUNT_NOT_INTEGER",
        "E_VERSION_UNSUPPORTED",
        "E_DOCUMENT_TYPE",
        "E_DUPLICATE_ID",
        "E_ACCOUNT_UNKNOWN",
        "E_CATEGORY_UNKNOWN",
        "E_REF_UNKNOWN",
        "E_ACCOUNT_KIND",
        "E_CURRENCY_MISMATCH",
        "E_SPLITS_UNBALANCED",
        "E_SPLIT_KIND",
        "E_TRANSFER_UNPAIRED",
        "E_TRANSFER_AMOUNT",
        "E_TRANSFER_SAME_ACCOUNT",
        "E_DATE_ORDER",
        "E_RECON_MISMATCH",
        "E_ALLOCATION_EXCEEDS",
        "E_BUCKET_SUM",
        "E_PARSE_DATE",
        "E_PARSE_AMOUNT",
        "E_PARSE_FIELD_COUNT",
        "E_PARSE_ENCODING",
        "E_ROW_UNRESOLVED",
        "E_DUPLICATE_UNRESOLVED",
        "E_BATCH_STATE",
        "E_STALE_VERSION",
        "E_COMMAND_PAYLOAD",
        "E_IDEMPOTENT_REPLAY",
        "E_MODULE_WRITES_LEDGER"
      ]
    },
    "contract": {
      "const": "perfin"
    }
  }
}
