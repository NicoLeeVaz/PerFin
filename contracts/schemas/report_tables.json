    "encoding": "utf-8",
    "bom": false,
    "delimiter": ",",
    "quote": "\"",
    "quoting": "RFC 4180 minimal; fields containing delimiter, quote, CR or LF are quoted; quotes doubled",
    "line_terminator": "\r\n",
    "header": "exact column names in this order",
    "null": "empty field",
    "boolean": "TRUE/FALSE",
    "date": "YYYY-MM-DD",
    "money_minor": "optional '-' then digits, integer minor units",
    "decimal_string": "digits with optional '.' fraction, no exponent"
  },
  "excel_rules": [
    "Tables are read-only refresh targets; refresh never writes back.",
    "text columns are written as text cells; a value starting with = + - @ TAB or CR is never evaluated as a formula.",
    "money_minor columns are integers; display formatting divides by 100 in the view layer only.",
    "display_balance_minor = ledger balance for assets and -ledger balance for liabilities (positive = amount owed)."
  ],
